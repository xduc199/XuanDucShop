@model IEnumerable<XuanDucShop.Models.ViewModels.InvoiceRowViewModel>
@using System.Globalization
@{ ViewData["Title"] = "Hóa đơn"; }

<div class="page-heading">
    <div><h1>Hóa đơn</h1><p>Lịch sử giao dịch và thông tin khách hàng.</p></div>
    <a asp-action="CreateInvoice" class="btn btn-primary">Tạo hóa đơn</a>
</div>
<section>
    @if (!Model.Any())
    {
        <p class="empty-state">Chưa có hóa đơn. Tạo hóa đơn để bắt đầu ghi nhận giao dịch.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover data-table align-middle mb-0">
                <thead><tr><th>Mã hóa đơn</th><th>Ngày tạo</th><th>Nhân viên lập</th><th>Khách hàng</th><th>Số điện thoại</th><th class="text-end">Tổng tiền</th><th>Chi tiết</th><th class="text-end">Thao tác</th></tr></thead>
                <tbody>
                @foreach (var invoice in Model)
                {
                    <tr>
                        <td><a asp-action="InvoiceDetail" asp-route-invoiceId="@invoice.Id" class="table-id">#@invoice.Id</a></td>
                        <td>@invoice.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@invoice.EmployeeName</td>
                        <td class="cell-primary">@invoice.CustomerName</td>
                        <td>@invoice.CustomerPhone</td>
                        <td class="text-end fw-semibold">@invoice.TotalAmount.ToString("N0", CultureInfo.GetCultureInfo("vi-VN")) ₫</td>
                        <td><a asp-action="InvoiceDetail" asp-route-invoiceId="@invoice.Id" class="table-action">Xem chi tiết</a></td>
                        <td class="text-end"><div class="row-actions"><a asp-action="EditInvoice" asp-route-id="@invoice.Id" class="table-action">Sửa</a><form asp-action="DeleteInvoice" asp-route-id="@invoice.Id" method="post" onsubmit="return confirm('Bạn có chắc muốn xóa hóa đơn này? Hãy xóa các dòng chi tiết trước.');">@Html.AntiForgeryToken()<button type="submit" class="table-action danger-action">Xóa</button></form></div></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
