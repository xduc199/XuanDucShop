@model IEnumerable<XuanDucShop.Models.Invoice>

@{
    ViewData["Title"] = "Hóa đơn";
    var employees = ViewBag.Employees as IEnumerable<XuanDucShop.Models.Employee> ?? Enumerable.Empty<XuanDucShop.Models.Employee>();
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">Danh sách hóa đơn</h1>
        <p class="text-secondary mb-0">Theo dõi giao dịch và thông tin khách hàng.</p>
    </div>
    <a asp-action="CreateInvoice" class="btn btn-primary">+ Tạo hóa đơn</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-3">Mã hóa đơn</th>
                    <th>Ngày tạo</th>
                    <th>Nhân viên</th>
                    <th>Khách hàng</th>
                    <th>Điện thoại</th>
                    <th class="text-end">Tổng tiền</th>
                    <th class="text-end pe-3">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var employeeName = employees.FirstOrDefault(x => x.Id == item.EmployeeId)?.FullName ?? "Không xác định";
                    <tr>
                        <td class="ps-3 fw-medium">HD@item.Id.ToString("000")</td>
                        <td class="text-nowrap">@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@employeeName</td>
                        <td>@item.CustomerName</td>
                        <td>@item.CustomerPhone</td>
                        <td class="text-end text-nowrap fw-semibold">@item.TotalAmount.ToString("N0") đ</td>
                        <td class="text-end text-nowrap pe-3">
                            <a asp-action="EditInvoice" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Sửa</a>
                            <form asp-action="DeleteInvoice" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Xóa hóa đơn này sẽ xóa cả chi tiết liên quan. Tiếp tục?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center text-secondary py-4">Chưa có hóa đơn nào.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
