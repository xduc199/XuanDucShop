@model IEnumerable<XuanDucShop.Models.InvoiceDetail>

@{
    ViewData["Title"] = "Chi tiết hóa đơn";
    var invoices = ViewBag.Invoices as IEnumerable<XuanDucShop.Models.Invoice> ?? Enumerable.Empty<XuanDucShop.Models.Invoice>();
    var products = ViewBag.Products as IEnumerable<XuanDucShop.Models.Product> ?? Enumerable.Empty<XuanDucShop.Models.Product>();
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">Chi tiết hóa đơn</h1>
        <p class="text-secondary mb-0">Quản lý sản phẩm, số lượng và đơn giá trong từng hóa đơn.</p>
    </div>
    <a asp-action="CreateInvoiceDetail" class="btn btn-primary">+ Thêm chi tiết</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-3">Mã</th>
                    <th>Hóa đơn</th>
                    <th>Sản phẩm</th>
                    <th class="text-end">Số lượng</th>
                    <th class="text-end">Đơn giá</th>
                    <th class="text-end">Thành tiền</th>
                    <th class="text-end pe-3">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var invoice = invoices.FirstOrDefault(x => x.Id == item.InvoiceId);
                    var product = products.FirstOrDefault(x => x.Id == item.ProductId);
                    <tr>
                        <td class="ps-3 text-secondary">#@item.Id</td>
                        <td>@(invoice == null ? "Không xác định" : $"HD{invoice.Id:000}")</td>
                        <td>@(product?.Name ?? "Không xác định")</td>
                        <td class="text-end">@item.Quantity</td>
                        <td class="text-end text-nowrap">@item.UnitPrice.ToString("N0") đ</td>
                        <td class="text-end text-nowrap fw-semibold">@((item.Quantity * item.UnitPrice).ToString("N0")) đ</td>
                        <td class="text-end text-nowrap pe-3">
                            <a asp-action="EditInvoiceDetail" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Sửa</a>
                            <form asp-action="DeleteInvoiceDetail" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa chi tiết này?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center text-secondary py-4">Chưa có chi tiết hóa đơn nào.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
