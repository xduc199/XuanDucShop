@model XuanDucShop.Models.ViewModels.DashboardViewModel
@using System.Globalization

@{ ViewData["Title"] = "Tổng quan"; }

<div class="page-heading">
    <div><h1>Tổng quan</h1><p>Tình hình hoạt động của cửa hàng.</p></div>
    <a asp-action="CreateInvoice" class="btn btn-primary">Tạo hóa đơn</a>
</div>

<section class="summary-grid" aria-label="Thống kê cửa hàng">
    <div class="summary-item"><span class="summary-label">Danh mục</span><span class="summary-value">@Model.CategoryCount</span></div>
    <div class="summary-item"><span class="summary-label">Sản phẩm</span><span class="summary-value">@Model.ProductCount</span></div>
    <div class="summary-item"><span class="summary-label">Nhân viên</span><span class="summary-value">@Model.EmployeeCount</span></div>
    <div class="summary-item"><span class="summary-label">Hóa đơn</span><span class="summary-value">@Model.InvoiceCount</span></div>
    <div class="summary-item"><span class="summary-label">Doanh thu</span><span class="summary-value revenue">@Model.Revenue.ToString("N0", CultureInfo.GetCultureInfo("vi-VN")) ₫</span></div>
</section>

<section aria-labelledby="recent-invoices-heading">
    <div class="section-heading">
        <h2 id="recent-invoices-heading">Hóa đơn gần đây</h2>
        <a asp-action="Invoice" class="small">Tất cả hóa đơn</a>
    </div>
    <div class="dashboard-table-wrap table-responsive">
        <table class="table table-hover data-table">
            <thead><tr><th scope="col">Mã hóa đơn</th><th scope="col">Khách hàng</th><th scope="col">Nhân viên</th><th scope="col" class="text-end">Tổng tiền</th></tr></thead>
            <tbody>
                @foreach (var invoice in Model.RecentInvoices)
                {
                    <tr>
                        <td><a asp-action="InvoiceDetail" asp-route-invoiceId="@invoice.Id">#@invoice.Id</a></td>
                        <td><span class="primary-value">@invoice.CustomerName</span><small class="d-block text-secondary">@invoice.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small></td>
                        <td>@invoice.EmployeeName</td>
                        <td class="text-end text-nowrap">@invoice.TotalAmount.ToString("N0", CultureInfo.GetCultureInfo("vi-VN")) ₫</td>
                    </tr>
                }
                @if (Model.RecentInvoices.Count == 0)
                {
                    <tr><td colspan="4" class="empty-state">Chưa có hóa đơn nào.</td></tr>
                }
            </tbody>
        </table>
    </div>
</section>

<nav class="quick-links" aria-label="Truy cập nhanh">
    <a asp-action="Category">Danh mục</a>
    <a asp-action="Product">Sản phẩm</a>
    <a asp-action="Employee">Nhân viên</a>
    <a asp-action="Invoice">Hóa đơn</a>
    <a asp-action="InvoiceDetail">Chi tiết hóa đơn</a>
</nav>
