@model IEnumerable<XuanDucShop.Models.Category>
@{ ViewData["Title"] = "Danh mục sản phẩm"; }

<div class="page-heading">
    <div><h1>Danh mục sản phẩm</h1><p>Quản lý các nhóm sản phẩm đang kinh doanh.</p></div>
    <a asp-action="CreateCategory" class="btn btn-primary">Thêm danh mục</a>
</div>
<section>
    @if (!Model.Any())
    {
        <p class="empty-state">Chưa có danh mục. Thêm danh mục đầu tiên để bắt đầu phân loại sản phẩm.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover data-table align-middle mb-0">
                <thead><tr><th>Mã danh mục</th><th>Tên danh mục</th><th>Mô tả</th><th class="text-end">Thao tác</th></tr></thead>
                <tbody>
                @foreach (var category in Model)
                {
                    <tr>
                        <td class="table-id">#@category.Id</td><td class="cell-primary">@category.Name</td><td class="description-cell">@(string.IsNullOrWhiteSpace(category.Description) ? "Chưa có mô tả" : category.Description)</td>
                        <td class="text-end"><div class="row-actions"><a asp-action="EditCategory" asp-route-id="@category.Id" class="table-action">Sửa</a><form asp-action="DeleteCategory" asp-route-id="@category.Id" method="post" onsubmit="return confirm('Bạn có chắc muốn xóa danh mục này? Danh mục đang có sản phẩm sẽ không thể xóa.');">@Html.AntiForgeryToken()<button type="submit" class="table-action danger-action">Xóa</button></form></div></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
