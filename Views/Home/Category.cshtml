@model IEnumerable<XuanDucShop.Models.Category>
@{ ViewData["Title"] = "Danh mục sản phẩm"; }
<h1>Danh mục sản phẩm</h1>
<table class="table table-striped"><thead><tr><th>Id</th><th>Tên danh mục</th><th>Mô tả</th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td>@item.Id</td><td>@item.Name</td><td>@item.Description</td></tr> }
</tbody></table>
