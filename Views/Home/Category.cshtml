@model IEnumerable<XuanDucShop.Models.Category>

@{
    ViewData["Title"] = "Danh mục sản phẩm";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">Danh mục sản phẩm</h1>
        <p class="text-secondary mb-0">Quản lý các nhóm sản phẩm của cửa hàng.</p>
    </div>
    <a asp-action="CreateCategory" class="btn btn-primary">+ Thêm danh mục</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-3" style="width: 90px;">Mã</th>
                    <th>Tên danh mục</th>
                    <th>Mô tả</th>
                    <th class="text-end pe-3" style="width: 170px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-3 text-secondary">#@item.Id</td>
                        <td class="fw-medium">@item.Name</td>
                        <td>@item.Description</td>
                        <td class="text-end pe-3">
                            <a asp-action="EditCategory" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Sửa</a>
                            <form asp-action="DeleteCategory" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa danh mục này?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="4" class="text-center text-secondary py-4">Chưa có danh mục nào.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
