@model XuanDucShop.Models.ViewModels.InvoiceFormViewModel
@{
    var formAction = Model.Id == 0 ? "CreateInvoice" : "EditInvoice";
    int? routeId = Model.Id == 0 ? null : Model.Id;
    ViewData["Title"] = ViewData["FormTitle"];
}

<div class="page-heading">
    <div><p class="eyebrow">BÁN HÀNG</p><h1>@ViewData["FormTitle"]</h1><p>Tổng tiền được tính tự động từ các dòng chi tiết hóa đơn.</p></div>
</div>
<section class="content-card form-card">
    <form asp-action="@formAction" asp-route-id="@routeId" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="EmployeeId" class="form-label">Nhân viên lập hóa đơn <span class="required-mark">*</span></label>
                <select asp-for="EmployeeId" asp-items="Model.EmployeeOptions" class="form-select">
                    <option value="0">Chọn nhân viên</option>
                </select>
                <span asp-validation-for="EmployeeId" class="field-error"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="CustomerName" class="form-label">Tên khách hàng <span class="required-mark">*</span></label>
                <input asp-for="CustomerName" class="form-control" placeholder="Nhập tên khách hàng" autocomplete="name" />
                <span asp-validation-for="CustomerName" class="field-error"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="CustomerPhone" class="form-label">Số điện thoại khách hàng</label>
                <input asp-for="CustomerPhone" type="tel" class="form-control" placeholder="Nhập số điện thoại" autocomplete="tel" />
                <span asp-validation-for="CustomerPhone" class="field-error"></span>
            </div>
        </div>
        <div class="form-actions"><a asp-action="Invoice" class="btn btn-light">Hủy</a><button type="submit" class="btn btn-primary">Lưu hóa đơn</button></div>
    </form>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
