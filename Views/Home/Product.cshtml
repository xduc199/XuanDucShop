@model IEnumerable<XuanDucShop.Models.Product>

@{
    ViewData["Title"] = "Sản phẩm";
    var categories = ViewBag.Categories as IEnumerable<XuanDucShop.Models.Category> ?? Enumerable.Empty<XuanDucShop.Models.Category>();
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">Sản phẩm</h1>
        <p class="text-secondary mb-0">Theo dõi giá bán, tồn kho và trạng thái kinh doanh.</p>
    </div>
    <a asp-action="CreateProduct" class="btn btn-primary">+ Thêm sản phẩm</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-3">Mã</th>
                    <th>Tên sản phẩm</th>
                    <th>Danh mục</th>
                    <th class="text-end">Đơn giá</th>
                    <th class="text-end">Tồn kho</th>
                    <th>Ảnh</th>
                    <th>Trạng thái</th>
                    <th class="text-end pe-3">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var categoryName = categories.FirstOrDefault(x => x.Id == item.CategoryId)?.Name ?? "Không xác định";
                    <tr>
                        <td class="ps-3 text-secondary">#@item.Id</td>
                        <td class="fw-medium">@item.Name</td>
                        <td>@categoryName</td>
                        <td class="text-end text-nowrap">@item.Price.ToString("N0") đ</td>
                        <td class="text-end">@item.StockQuantity</td>
                        <td>@(string.IsNullOrWhiteSpace(item.ImageFileName) ? "—" : item.ImageFileName)</td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge text-bg-success">Đang bán</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">Ngừng bán</span>
                            }
                        </td>
                        <td class="text-end text-nowrap pe-3">
                            <a asp-action="EditProduct" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Sửa</a>
                            <form asp-action="DeleteProduct" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa sản phẩm này?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="8" class="text-center text-secondary py-4">Chưa có sản phẩm nào.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
