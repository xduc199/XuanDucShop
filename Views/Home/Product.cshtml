@model IEnumerable<XuanDucShop.Models.Product>
@{ ViewData["Title"] = "Danh sách sản phẩm"; }
<h1>Danh sách sản phẩm</h1>
<table class="table table-striped"><thead><tr><th>Id</th><th>Tên sản phẩm</th><th>Danh mục</th><th>Đơn giá</th><th>Tồn kho</th><th>Ảnh</th><th>Trạng thái</th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td>@item.Id</td><td>@item.Name</td><td>@item.CategoryId</td><td>@item.Price.ToString("N0") đ</td><td>@item.StockQuantity</td><td>@item.ImageFileName</td><td>@(item.IsActive ? "Đang bán" : "Ngừng bán")</td></tr> }
</tbody></table>
