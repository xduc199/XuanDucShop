@model IEnumerable<XuanDucShop.Models.ViewModels.ProductRowViewModel>
@using System.Globalization
@{ ViewData["Title"] = "Sản phẩm"; }

<div class="page-heading">
    <div><h1>Sản phẩm</h1><p>Theo dõi mặt hàng, giá bán và số lượng tồn.</p></div>
    <a asp-action="CreateProduct" class="btn btn-primary">Thêm sản phẩm</a>
</div>
<section>
    @if (!Model.Any())
    {
        <p class="empty-state">Chưa có sản phẩm. Thêm sản phẩm đầu tiên để bắt đầu quản lý hàng hóa.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover data-table align-middle mb-0">
                <thead><tr><th>Mã</th><th>Sản phẩm</th><th>Danh mục</th><th class="text-end">Đơn giá</th><th class="text-center">Tồn kho</th><th>Trạng thái</th><th class="text-end">Thao tác</th></tr></thead>
                <tbody>
                @foreach (var product in Model)
                {
                    <tr>
                        <td class="table-id">#@product.Id</td>
                        <td><span class="cell-primary">@product.Name</span><small class="cell-secondary d-block">@(string.IsNullOrWhiteSpace(product.ImageFileName) ? "Chưa có hình ảnh" : product.ImageFileName)</small></td>
                        <td>@product.CategoryName</td>
                        <td class="text-end fw-semibold">@product.Price.ToString("N0", CultureInfo.GetCultureInfo("vi-VN")) ₫</td>
                        <td class="text-center"><span class="stock-value @(product.StockQuantity == 0 ? "stock-empty" : "")">@product.StockQuantity</span></td>
                        <td><span class="status-badge @(product.IsActive ? "status-active" : "status-inactive")">@(product.IsActive ? "Đang kinh doanh" : "Ngừng kinh doanh")</span></td>
                        <td class="text-end"><div class="row-actions"><a asp-action="EditProduct" asp-route-id="@product.Id" class="table-action">Sửa</a><form asp-action="DeleteProduct" asp-route-id="@product.Id" method="post" onsubmit="return confirm('Bạn có chắc muốn xóa sản phẩm này? Sản phẩm đã có trong hóa đơn sẽ không thể xóa.');">@Html.AntiForgeryToken()<button type="submit" class="table-action danger-action">Xóa</button></form></div></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
