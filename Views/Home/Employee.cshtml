@model IEnumerable<XuanDucShop.Models.Employee>

@{
    ViewData["Title"] = "Nhân viên";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">Danh sách nhân viên</h1>
        <p class="text-secondary mb-0">Quản lý thông tin liên hệ và trạng thái làm việc.</p>
    </div>
    <a asp-action="CreateEmployee" class="btn btn-primary">+ Thêm nhân viên</a>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-3">Mã</th>
                    <th>Họ và tên</th>
                    <th>Điện thoại</th>
                    <th>Email</th>
                    <th>Mã tài khoản</th>
                    <th>Trạng thái</th>
                    <th class="text-end pe-3">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-3 text-secondary">#@item.Id</td>
                        <td class="fw-medium">@item.FullName</td>
                        <td>@item.Phone</td>
                        <td>@item.Email</td>
                        <td>@item.UserId</td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge text-bg-success">Đang làm</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">Đã nghỉ</span>
                            }
                        </td>
                        <td class="text-end text-nowrap pe-3">
                            <a asp-action="EditEmployee" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Sửa</a>
                            <form asp-action="DeleteEmployee" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa nhân viên này?');">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center text-secondary py-4">Chưa có nhân viên nào.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
