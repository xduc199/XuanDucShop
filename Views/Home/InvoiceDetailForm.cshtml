@model XuanDucShop.ViewModels.InvoiceDetailFormViewModel

@{
    var isEdit = Model.InvoiceDetail.Id != 0;
    var actionName = isEdit ? "EditInvoiceDetail" : "CreateInvoiceDetail";
    ViewData["Title"] = isEdit ? "Sửa chi tiết hóa đơn" : "Thêm chi tiết hóa đơn";
}

<div class="mb-4">
    <a asp-action="InvoiceDetail" class="text-decoration-none small">← Chi tiết hóa đơn</a>
    <h1 class="h3 mt-2 mb-1">@ViewData["Title"]</h1>
    <p class="text-secondary mb-0">Thành tiền và tổng hóa đơn sẽ được tính lại sau khi lưu.</p>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <form asp-action="@actionName" asp-route-id="@Model.InvoiceDetail.Id" method="post">
            <input asp-for="InvoiceDetail.Id" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="InvoiceDetail.InvoiceId" class="form-label"></label>
                    <select asp-for="InvoiceDetail.InvoiceId" asp-items="Model.Invoices" class="form-select">
                        <option value="">-- Chọn hóa đơn --</option>
                    </select>
                    <span asp-validation-for="InvoiceDetail.InvoiceId" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="InvoiceDetail.ProductId" class="form-label"></label>
                    <select asp-for="InvoiceDetail.ProductId" asp-items="Model.Products" class="form-select">
                        <option value="">-- Chọn sản phẩm --</option>
                    </select>
                    <span asp-validation-for="InvoiceDetail.ProductId" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="InvoiceDetail.Quantity" class="form-label"></label>
                    <input asp-for="InvoiceDetail.Quantity" class="form-control" type="number" min="1" />
                    <span asp-validation-for="InvoiceDetail.Quantity" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="InvoiceDetail.UnitPrice" class="form-label"></label>
                    <div class="input-group">
                        <input asp-for="InvoiceDetail.UnitPrice" class="form-control" type="number" min="0.01" step="0.01" />
                        <span class="input-group-text">đ</span>
                    </div>
                    <span asp-validation-for="InvoiceDetail.UnitPrice" class="text-danger small"></span>
                </div>
            </div>
            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">Lưu chi tiết</button>
                <a asp-action="InvoiceDetail" class="btn btn-light border">Hủy</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
