<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - XuanDucShop</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
@{
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    bool IsCurrent(params string[] actions) => actions.Contains(currentAction, StringComparer.OrdinalIgnoreCase);
}
<body>
    <header class="shop-header">
        <nav class="navbar navbar-expand-lg" aria-label="Điều hướng chính">
            <div class="container">
                <a class="navbar-brand shop-brand" asp-controller="Home" asp-action="Index">XuanDucShop</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Mở menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav ms-lg-auto shop-nav">
                        <li class="nav-item"><a class="nav-link @(IsCurrent("Index") ? "active" : "")" aria-current="@(IsCurrent("Index") ? "page" : null)" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                        <li class="nav-item"><a class="nav-link @(IsCurrent("Category", "CreateCategory", "EditCategory") ? "active" : "")" aria-current="@(IsCurrent("Category", "CreateCategory", "EditCategory") ? "page" : null)" asp-controller="Home" asp-action="Category">Danh mục</a></li>
                        <li class="nav-item"><a class="nav-link @(IsCurrent("Product", "CreateProduct", "EditProduct") ? "active" : "")" aria-current="@(IsCurrent("Product", "CreateProduct", "EditProduct") ? "page" : null)" asp-controller="Home" asp-action="Product">Sản phẩm</a></li>
                        <li class="nav-item"><a class="nav-link @(IsCurrent("Employee", "CreateEmployee", "EditEmployee") ? "active" : "")" aria-current="@(IsCurrent("Employee", "CreateEmployee", "EditEmployee") ? "page" : null)" asp-controller="Home" asp-action="Employee">Nhân viên</a></li>
                        <li class="nav-item"><a class="nav-link @(IsCurrent("Invoice", "CreateInvoice", "EditInvoice") ? "active" : "")" aria-current="@(IsCurrent("Invoice", "CreateInvoice", "EditInvoice") ? "page" : null)" asp-controller="Home" asp-action="Invoice">Hóa đơn</a></li>
                        <li class="nav-item"><a class="nav-link @(IsCurrent("InvoiceDetail", "CreateInvoiceDetail", "EditInvoiceDetail") ? "active" : "")" aria-current="@(IsCurrent("InvoiceDetail", "CreateInvoiceDetail", "EditInvoiceDetail") ? "page" : null)" asp-controller="Home" asp-action="InvoiceDetail">Chi tiết hóa đơn</a></li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="container shop-main">
        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="alert alert-success alert-dismissible fade show" role="status">
                @successMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @errorMessage
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="shop-footer py-3">
        <div class="container small">© @DateTime.Now.Year XuanDucShop</div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
